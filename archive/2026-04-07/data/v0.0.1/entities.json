    "full_context": {
      "product": "P-Zerø",
      "description": "P-Zerø is an end-to-end wind power forecasting product that combines physics-based weather inputs with machine-learning models to produce operational forecasts for energy sites. The product spans ingestion of meteo and site data, feature engineering, model training/versioning, inference datalake outputs, monitoring/alerting, performance evaluation, and commercial delivery through pricing, contracts, and customer reporting. Current maturity is mixed: production inference works, but core lifecycle controls (data versioning, lineage, experiment standardization, model governance, and active observability ownership) are fragmented, which limits reproducibility, auditability, and scaling confidence. The strategic objective is to evolve from a working but loosely coupled system into a governed product operating model with traceable data/model lineage, repeatable experiments, clear deployment and ownership boundaries, measurable performance history, and a business layer that can reliably tie forecast quality to customer value and revenue decisions.",
      "current_problem": "Infrastructure and lifecycle practices are fragmented.",
      "impact": "Scaling and reproducibility are constrained.",
      "target": "Single product intelligence source of truth.",
      "importance": "Critical"
    }
  },
